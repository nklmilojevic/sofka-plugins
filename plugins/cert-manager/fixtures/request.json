{
  "schema_version": 1,
  "context": "development",
  "cluster": "development",
  "namespace": "apps",
  "resource": "certificates",
  "name": "web-tls",
  "filter": "",
  "inputs": {
    "replay": "plugins/cert-manager/fixtures/status.txt"
  },
  "object": {
    "apiVersion": "cert-manager.io/v1",
    "kind": "Certificate",
    "metadata": {
      "name": "web-tls",
      "namespace": "apps"
    },
    "spec": {
      "secretName": "web-tls",
      "dnsNames": [
        "web.example.com",
        "www.example.com"
      ],
      "issuerRef": {
        "name": "letsencrypt",
        "kind": "ClusterIssuer",
        "group": "cert-manager.io"
      }
    }
  },
  "forward": null
}
